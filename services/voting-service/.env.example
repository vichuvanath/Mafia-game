# Application
APP_ENV=development
APP_NAME=voting-service
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security & Authentication
SERVICE_TOKEN=dev-secret-internal-service-token-change-in-production
JWT_SECRET=dev-jwt-secret-shared-key-for-test-only-change-in-production
JWT_ALGORITHM=HS256
JWT_AUDIENCE=
JWT_ISSUER=

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://voting_user:voting_password@localhost:5432/voting_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# Cache & Distributed Locks / Scheduler (Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=voting:

# Message Broker (RabbitMQ)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=mafia.events

# Rate Limiting
RATE_LIMIT_VOTES_PER_MINUTE=60

