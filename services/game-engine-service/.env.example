# Application Configuration
APP_NAME=game-engine-service
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://game_engine_user:game_engine_pass@localhost:5432/game_engine_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Redis Cache and Scheduler
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=game:

# RabbitMQ Event Broker
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=mafia.events
RABBITMQ_QUEUE_PREFIX=game_engine

# Security & Authentication
INTERNAL_SERVICE_TOKEN=dev-secret-internal-service-token
JWT_SECRET_KEY=dev-jwt-secret-key-32-chars-minimum-required!
JWT_ALGORITHM=HS256

# Client Integrations ("fake" or "http")
CLIENT_MODE=fake
ROLE_SERVICE_URL=http://localhost:8001
VOTING_SERVICE_URL=http://localhost:8002

# Game Rules Configuration
GAME_RULES__MIN_PLAYERS=5
GAME_RULES__MAX_PLAYERS=12
GAME_RULES__ROLE_ASSIGNMENT_TIMEOUT_SECONDS=30
GAME_RULES__NIGHT_PHASE_DURATION_SECONDS=30
GAME_RULES__NIGHT_RESOLUTION_DURATION_SECONDS=5
GAME_RULES__DAY_PHASE_DURATION_SECONDS=5
GAME_RULES__DISCUSSION_PHASE_DURATION_SECONDS=45
GAME_RULES__VOTING_PHASE_DURATION_SECONDS=30
GAME_RULES__ELIMINATION_PHASE_DURATION_SECONDS=5
GAME_RULES__DOCTOR_CAN_SELF_PROTECT=true
GAME_RULES__TIE_RULE=REVOTE_AMONG_TIED
GAME_RULES__MAX_REVOTES=1
GAME_RULES__ABSTENTION_HANDLING=COUNT_AS_ABSTAIN
GAME_RULES__REVEAL_ROLE_ON_DEATH=true
GAME_RULES__DISCONNECT_GRACE_PERIOD_SECONDS=60
