{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoomReadyEvent",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "game_id", "version", "payload"],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "type": "string", "const": "ROOM_READY" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "game_id": { "type": "string" },
    "version": { "type": "integer" },
    "payload": {
      "type": "object",
      "required": ["room_id", "player_ids"],
      "properties": {
        "room_id": { "type": "string" },
        "player_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 3
        },
        "player_names": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
